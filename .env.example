# Copy to .env and change both values
CLICKHOUSE_PASSWORD=change-me-clickhouse
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Optional. Address the OTLP port 4317 is published on: 127.0.0.1 = this PC only, 0.0.0.0 = LAN (default).
# On Linux, Docker bypasses ufw/firewalld for published ports, so this is what limits access.
# OTLP_BIND=127.0.0.1
# Optional. Address Grafana (port 3000) is published on: 127.0.0.1 = this PC only (default), 0.0.0.0 = LAN.
# setup-server.sh on Linux sets it to 0.0.0.0 unless you pass --local-only.
# GRAFANA_BIND=127.0.0.1
# Optional. Host port of Grafana (default 3000); use another one when 3000 is taken. The Windows script assumes 3000.
# GRAFANA_PORT=3000
# Optional. ClickHouse image tag (default 25.8). setup-server.sh sets 23.3.22.3 on ARM CPUs without lrcpc (Raspberry Pi 4).
# CLICKHOUSE_VERSION=25.8

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git ls-files*)",
      "Bash(git grep*)",
      "Bash(git rev-parse*)",
      "Bash(git branch --show-current)",
      "Bash(git ls-tree*)",
      "Bash(git check-ignore*)",
      "Bash(git rev-list*)",
      "Bash(git cat-file*)",
      "Bash(git --version)",
      "Bash(git -C * status*)",
      "Bash(git -C * log*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * show*)",
      "Bash(git -C * blame*)",
      "Bash(git -C * ls-files*)",
      "Bash(git -C * grep*)",
      "Bash(git -C * rev-parse*)",
      "Bash(git -C * branch --show-current)",
      "Bash(node claude-context/scripts/check-dashboard.js*)",
      "Bash(py -3 claude-context/skills/commit-message/scripts/check-msg.py *)"
    ],
    "deny": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(git reset*)",
      "Bash(git stash*)",
      "Bash(git rebase*)",
      "Bash(git merge)",
      "Bash(git merge *)",
      "Bash(git cherry-pick*)",
      "Bash(git revert*)",
      "Bash(git tag*)",
      "Bash(git rm*)",
      "Bash(git mv*)",
      "Bash(git clean*)",
      "Bash(git am*)",
      "Bash(git apply*)",
      "Bash(git init*)",
      "Bash(git worktree*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch -m*)",
      "Bash(git branch -M*)",
      "Bash(git branch --delete*)",
      "Bash(git branch --move*)",
      "Bash(git -C * add*)",
      "Bash(git -C * commit*)",
      "Bash(git -C * push*)",
      "Bash(git -C * pull*)",
      "Bash(git -C * fetch*)",
      "Bash(git -C * checkout*)",
      "Bash(git -C * switch*)",
      "Bash(git -C * restore*)",
      "Bash(git -C * reset*)",
      "Bash(git -C * stash*)",
      "Bash(git -C * rebase*)",
      "Bash(git -C * merge)",
      "Bash(git -C * merge *)",
      "Bash(git -C * cherry-pick*)",
      "Bash(git -C * revert*)",
      "Bash(git -C * tag*)",
      "Bash(git -C * rm*)",
      "Bash(git -C * mv*)",
      "Bash(git -C * clean*)",
      "Bash(git -C * am*)",
      "Bash(git -C * apply*)",
      "Bash(git -C * init)",
      "Bash(git -C * init *)",
      "Bash(git -C * worktree*)",
      "Bash(git -C * branch -d*)",
      "Bash(git -C * branch -D*)",
      "Bash(git -C * branch -m*)",
      "Bash(git -C * branch -M*)",
      "Bash(git -C * branch --delete*)",
      "Bash(git -C * branch --move*)",
      "Bash(cmd //c rmdir*)",
      "Bash(cmd /c rmdir*)",
      "Bash(rmdir*)",
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(*docker compose down -v*)",
      "Bash(*docker compose down --volumes*)",
      "Bash(*docker volume rm*)",
      "Bash(*docker volume prune*)",
      "Bash(*wsl --unregister*)",
      "Read(**/.env)",
      "Read(**/backup/**)",
      "Edit(**/.env)",
      "Edit(**/settings.json)",
      "Edit(**/settings.local.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-secrets.py\""
          }
        ]
      }
    ]
  }
}

<!-- default profile for every ClickHouse version and machine: do not log queries (the log tables are removed
     in clickhouse/config.d/common.xml). The resource limits of a small server are in clickhouse/limits/. -->
<clickhouse>
  <profiles>
    <default>
      <log_queries>0</log_queries>
      <log_query_views>0</log_query_views>
    </default>
  </profiles>
</clickhouse>

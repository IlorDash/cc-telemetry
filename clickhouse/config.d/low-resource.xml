<!-- Raspberry Pi 4 (4 cores, 8 GB shared with other services): drop the system logs
     nobody reads (query_log included), cap memory and background work, keep the text log small
     (the image default `trace` wrote ~135 MB a day to the SD card). -->
<clickhouse>
  <!-- Merged into the image's <logger>: only these three change, the log paths stay.
       Errors also go to clickhouse-server.err.log. -->
  <logger>
    <level>warning</level>
    <size>10M</size>
    <count>2</count>
  </logger>

  <asynchronous_metric_log remove="1"/>
  <metric_log remove="1"/>
  <query_thread_log remove="1"/>
  <part_log remove="1"/>
  <session_log remove="1"/>
  <trace_log remove="1"/>
  <text_log remove="1"/>
  <query_log remove="1"/>
  <query_views_log remove="1"/>

  <max_server_memory_usage>3000000000</max_server_memory_usage>
  <mark_cache_size>268435456</mark_cache_size>
  <uncompressed_cache_size>0</uncompressed_cache_size>
  <max_concurrent_queries>8</max_concurrent_queries>
  <merge_tree>
    <!-- Defaults (8 and 20) exceed the 2 x 2 merge slots, which would pin merges to the 1 MiB minimum size. -->
    <number_of_free_entries_in_pool_to_lower_max_size_of_merge>2</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
    <number_of_free_entries_in_pool_to_execute_mutation>2</number_of_free_entries_in_pool_to_execute_mutation>
  </merge_tree>
</clickhouse>
